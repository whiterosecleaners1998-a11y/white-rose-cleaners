# Postgres connection string (Vercel Marketplace -> Neon/Prisma Postgres, etc.)
DATABASE_URL=""

# Shared password to access the portal.
APP_PASSWORD=""
# Random secret used to sign login sessions, e.g: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
# Shown on the receipt, the PDF and the portal header.
SHOP_NAME="Your Dry Cleaner"
# The shop's logo, on the login screen, the sidebar and every receipt. Either a
# file placed in public/ and named here, or a full https:// URL. Leave blank and
# the shop name stands in for it.
NEXT_PUBLIC_SHOP_LOGO="/your-shop-logo.png"
# Small line under the shop name in the sidebar. Optional.
NEXT_PUBLIC_SHOP_TAGLINE=""
# Prefix used for human-readable booking numbers, e.g. WRD-00001.
BOOKING_PREFIX="WRD"
# Contact numbers printed on the receipt under the booking number.
# Format: "Name:Number,Name:Number".
SHOP_CONTACTS="Faizan:0333-1231404,Wajid Ali:0345-2235356"

# Shop owner's WhatsApp number (intl format, e.g. +923001234567).
# Powers the one-click "Notify Owner" button on the booking form — a plain
# wa.me link that opens WhatsApp with the message pre-typed. Leave blank to
# hide that button; the customer buttons work without it.
NEXT_PUBLIC_OWNER_WHATSAPP_NUMBER=""
# Country code (no +) prepended to locally-typed phone numbers when building
# wa.me links, e.g. 0300... -> 92300...
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE="92"

# Shown in the "Visit the shop" block on the public website. Both optional —
# left blank, that part of the page simply is not rendered rather than standing
# there with a placeholder. SHOP_ADDRESS may span lines.
SHOP_ADDRESS=""
SHOP_HOURS="Mon-Sat, 9am-9pm"

# Monthly packages, shown on /packages. Left blank there is no packages page
# and no link to one — the site never quotes a package price the shop did not
# set. Format: "pieces:price,pieces:price", star the one to push.
SHOP_PACKAGES="50:5900,100:10300*,150:13200"
# What the pickup form offers. Trim it if the shop does not do all four.
SHOP_SERVICES="Wash & Iron,Wash Only,Iron / Press Only,Dry Cleaning"
# The collection windows offered on the pickup form.
SHOP_PICKUP_SLOTS="12:00 PM - 3:00 PM,3:00 PM - 6:00 PM,6:00 PM - 9:00 PM"

# The same mark reversed for dark surfaces (the website footer). A black
# wordmark cannot go on an ink panel — the type vanishes, and a file with no
# transparency lands as a white slab. Leave blank and dark surfaces show the
# shop name in type instead.
NEXT_PUBLIC_SHOP_LOGO_DARK="/your-shop-logo-reversed.png"
