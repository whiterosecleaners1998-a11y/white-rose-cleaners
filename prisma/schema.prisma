// Prisma schema for the dry cleaner portal.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus {
  RECEIVED
  READY
  DELIVERED
  // Voided rather than erased: the row keeps its booking number so a customer
  // turning up with an old receipt still finds it, but it drops out of the
  // orders list and every revenue figure. Reversible.
  CANCELLED
}

model Booking {
  id                    String        @id @default(cuid())
  bookingNumber         Int           @unique @default(autoincrement())
  customerName          String
  phone                 String
  status                BookingStatus @default(RECEIVED)
  totalAmount           Decimal       @db.Decimal(10, 2)
  // Money taken so far, whether an advance at drop-off or the balance on
  // collection. What is still owed is totalAmount - paidAmount; it is derived
  // rather than stored so the two can never disagree.
  paidAmount            Decimal       @default(0) @db.Decimal(10, 2)
  notes                 String?
  createdAt             DateTime      @default(now())
  readyAt               DateTime?
  deliveredAt           DateTime?
  cancelledAt           DateTime?
  confirmationSmsSentAt DateTime?
  readySmsSentAt        DateTime?
  items                 BookingItem[]

  @@index([phone])
  @@index([createdAt])
}

model BookingItem {
  id        String  @id @default(cuid())
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId String
  itemName  String
  unitPrice Decimal @db.Decimal(10, 2)
  quantity  Int
  lineTotal Decimal @db.Decimal(10, 2)
}

model PriceListItem {
  id        String       @id @default(cuid())
  name      String       @unique
  price     Decimal      @db.Decimal(10, 2)
  active    Boolean      @default(true)
  sortOrder Int          @default(0)
  bundles   BundleItem[]
}

// A named group of price list items, e.g. "Suit" = 1 Kameez + 1 Shalwar.
// Pressing it on the booking form drops every line into the cart at once.
model Bundle {
  id        String       @id @default(cuid())
  name      String       @unique
  active    Boolean      @default(true)
  sortOrder Int          @default(0)
  // The keyboard key the shop chose for this bundle on the booking form. Null
  // means it takes whichever spare home-row letter is going. Uniqueness is
  // enforced among active bundles in the API rather than by the database, so a
  // removed bundle never keeps a letter hostage.
  shortcut  String?
  items     BundleItem[]
}

model BundleItem {
  id       String        @id @default(cuid())
  bundle   Bundle        @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  bundleId String
  item     PriceListItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId   String
  quantity Int           @default(1)

  @@unique([bundleId, itemId])
}

// The shop password, once it has been changed from the APP_PASSWORD the app
// was first handed. One row, keyed by a fixed id: only the scrypt hash is
// stored, never the password itself, and until the first change the env var
// stays the answer. See lib/password.ts.
model ShopCredential {
  id           String   @id
  passwordHash String
  updatedAt    DateTime @updatedAt
}

// What a customer asks for on the public website, before anything has changed
// hands. Deliberately not a Booking: nothing has been counted, nothing is
// owed, and it may never turn into anything. The counter reads these on
// /portal/requests and raises a real Booking from one if it is genuine.
enum RequestKind {
  // "Come and collect my washing" — the pickup form.
  PICKUP
  // "I want one of the monthly packages" — the packages page.
  PACKAGE
}

enum RequestStatus {
  NEW
  // Someone at the shop has spoken to them. Kept apart from CLOSED so a
  // request being worked on does not look the same as one that is finished.
  CONTACTED
  CLOSED
}

model ServiceRequest {
  id            String               @id @default(cuid())
  kind          RequestKind          @default(PICKUP)
  status        RequestStatus        @default(NEW)
  customerName  String
  phone         String
  email         String?
  address       String?
  preferredDate DateTime?
  timeSlot      String?
  serviceType   String?
  // Which tier they picked, on a PACKAGE request.
  packageName   String?
  note          String?
  // What the bill calculator came to, if they arrived that way. Stored as a
  // snapshot with its own line items rather than pointing at the price list,
  // because prices move and the figure the customer was shown should not move
  // with them.
  estimateTotal Decimal?             @db.Decimal(10, 2)
  items         ServiceRequestItem[]
  createdAt     DateTime             @default(now())
  handledAt     DateTime?

  @@index([status, createdAt])
  @@index([phone])
}

model ServiceRequestItem {
  id        String         @id @default(cuid())
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String
  itemName  String
  unitPrice Decimal        @db.Decimal(10, 2)
  quantity  Int
}
