// Prisma schema for the dry cleaner portal.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus {
  RECEIVED
  READY
  DELIVERED
}

model Booking {
  id                    String        @id @default(cuid())
  bookingNumber         Int           @unique @default(autoincrement())
  customerName          String
  phone                 String
  status                BookingStatus @default(RECEIVED)
  totalAmount           Decimal       @db.Decimal(10, 2)
  // Money taken so far, whether an advance at drop-off or the balance on
  // collection. What is still owed is totalAmount - paidAmount; it is derived
  // rather than stored so the two can never disagree.
  paidAmount            Decimal       @default(0) @db.Decimal(10, 2)
  notes                 String?
  createdAt             DateTime      @default(now())
  readyAt               DateTime?
  deliveredAt           DateTime?
  confirmationSmsSentAt DateTime?
  readySmsSentAt        DateTime?
  items                 BookingItem[]

  @@index([phone])
  @@index([createdAt])
}

model BookingItem {
  id        String  @id @default(cuid())
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId String
  itemName  String
  unitPrice Decimal @db.Decimal(10, 2)
  quantity  Int
  lineTotal Decimal @db.Decimal(10, 2)
}

model PriceListItem {
  id        String       @id @default(cuid())
  name      String       @unique
  price     Decimal      @db.Decimal(10, 2)
  active    Boolean      @default(true)
  sortOrder Int          @default(0)
  bundles   BundleItem[]
}

// A named group of price list items, e.g. "Suit" = 1 Kameez + 1 Shalwar.
// Pressing it on the booking form drops every line into the cart at once.
model Bundle {
  id        String       @id @default(cuid())
  name      String       @unique
  active    Boolean      @default(true)
  sortOrder Int          @default(0)
  // The keyboard key the shop chose for this bundle on the booking form. Null
  // means it takes whichever spare home-row letter is going. Uniqueness is
  // enforced among active bundles in the API rather than by the database, so a
  // removed bundle never keeps a letter hostage.
  shortcut  String?
  items     BundleItem[]
}

model BundleItem {
  id       String        @id @default(cuid())
  bundle   Bundle        @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  bundleId String
  item     PriceListItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId   String
  quantity Int           @default(1)

  @@unique([bundleId, itemId])
}
